{
  "name": "wallet-mcp",
  "version": "1.0.0",
  "description": "MCP server for the BudgetBakers Wallet REST API — query personal finance data through Claude Desktop",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --outDir dist",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "prepublishOnly": "pnpm run build",
    "lint": "biome check src"
  },
  "bin": {
    "wallet-mcp": "dist/index.js"
  },
  "keywords": ["mcp", "wallet", "budgetbakers", "personal-finance", "claude"],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "^1.3.9",
    "@types/node": "^25.3.0",
    "typescript": "^5.9.3"
  }
}
